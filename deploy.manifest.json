{
  "$schema": "https://raw.githubusercontent.com/cathyyul/workspace-infra/main/schemas/deploy.manifest.schema.json",
  "repo": "notify-shim",
  "github": "cathyyul/notify-shim",
  "default_branch": "main",
  "runtime": "deployed",
  "targets": [
    { "src": "notify-dm", "dest": "scripts/notify-dm", "mode": "managed", "chmod": "0755" },
    { "src": "notify-group-couple", "dest": "scripts/notify-group-couple", "mode": "managed", "chmod": "0755" },
    { "src": "notify-group-family", "dest": "scripts/notify-group-family", "mode": "managed", "chmod": "0755" },
    { "src": "notify_core.py", "dest": "scripts/notify_core.py", "mode": "managed", "chmod": "0644" },
    { "src": "notifiers/*.sh", "dest": "scripts/", "mode": "managed", "chmod": "0755" },
    { "src": "notifiers/*.py", "dest": "scripts/", "mode": "managed", "chmod": "0755" },
    {
      "src": "launchagents/com.openclaw.channel-watchdog.plist",
      "dest": "~/Library/LaunchAgents/com.openclaw.channel-watchdog.plist",
      "mode": "template",
      "vars": ["WS", "OPENCLAW_BIN"],
      "chmod": "0644",
      "launchctl": "bootstrap",
      "run_evidence": {"path": "data/health/openclaw-channel-watchdog.json"},
      "note": "channel-watchdog 是常駐服務（RunAtLoad）——bootstrap 讓載入變顯式且可重現。舊 deploy.sh 只 install 靠手動一次性載入＋RunAtLoad；改 bootstrap 是刻意的行為修正（S4，見 workspace-infra#15）。bootstrap 冪等：內容不變且已載入就不重載，不打斷運行中的 watchdog。"
    },
    {
      "src": "launchagents/com.openclaw.claude-scheduler-watchdog.plist",
      "dest": "~/Library/LaunchAgents/com.openclaw.claude-scheduler-watchdog.plist",
      "mode": "template",
      "vars": ["WS"],
      "chmod": "0644",
      "launchctl": "bootstrap",
      "run_evidence": {"path": "data/health/claude-scheduler-watchdog.json"},
      "note": "每小時掃 ~/Library/Logs/Claude/main.log：session_stale_relogin／spawn 逾時未 Confirmed → notify-dm 告警（帶原因＋修法＋受影響 task 清單，12h cooldown、新 task 可再發）；恢復後發恢復通知（notify-shim#22，2026-08-18 靜默失敗 20h 事故的 watchdog）。"
    },
    {
      "src": "routes.example.json",
      "dest": "~/.openclaw/notify/routes.json",
      "mode": "seed",
      "chmod": "0600",
      "note": "真實 routes.json（含 chat/user/group id）住 repo 外，永不覆蓋既有"
    },
    {
      "src": "failure-alert.example.json",
      "dest": "~/.openclaw/notify/failure-alert.json",
      "mode": "seed",
      "chmod": "0600",
      "note": "notify-shim#26 部分 channel 失敗時的 email 告警設定（真實收件/寄件帳號住 repo 外的本地 ~/.openclaw/notify/failure-alert.json，同 routes.json 慣例；repo 只放 placeholder，seed 永不覆蓋既有）"
    }
  ],
  "removals": [
    {
      "path": "~/Library/LaunchAgents/com.openclaw.couple-review-nudge.plist",
      "launchctl": true,
      "note": "notify-shim#47：Chi 改看 LINE 群組，group-couple 收斂為 LINE-only，每日 21:00 的 Chi review-email nudge 退役——deploy 先 bootout 再刪 plist"
    },
    {
      "path": "scripts/couple_review_email_nudge.py",
      "note": "notify-shim#47：nudge 腳本隨 LaunchAgent 退役（notifiers/*.py glob 不再含它，顯式刪除避免殘留 UNOWNED）"
    }
  ],
  "hooks": { "pre": "hooks/pre_deploy.sh", "post": null }
}
